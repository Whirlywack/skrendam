# Neon (yip project). Pooled URL for the app; direct/unpooled for `drizzle-kit pull`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Auth.js v5 — single admin
AUTH_SECRET=
AUTH_TRUST_HOST=true
ADMIN_USERNAME=admin
# bcryptjs hash. IMPORTANT: escape every '$' as '\$' (dotenv-expand interpolates
# unescaped '$' and would silently blank the hash). e.g. \$2b\$12\$....
ADMIN_PASSWORD_HASH=
E2E_ADMIN_PASSWORD=
