# Neon (yip project). Pooled URL for the app; direct/unpooled for `drizzle-kit pull`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Auth.js v5 — single admin
AUTH_SECRET=
AUTH_TRUST_HOST=true
ADMIN_USERNAME=admin
# bcryptjs hash. IMPORTANT: escape every '$' as '\$' (dotenv-expand interpolates
# unescaped '$' and would silently blank the hash). e.g. \$2b\$12\$....
ADMIN_PASSWORD_HASH=
E2E_ADMIN_PASSWORD=
# Resend API key. Unset = email disabled: every send path is a no-op (stats.skipped_no_key).
RESEND_API_KEY=
# Sender shown in inboxes; defaults to 'Yip <hello@yip.lt>'.
YIP_FROM_EMAIL=
# Public site base for links in mail (tracked /go, unsubscribe); defaults to https://yip.lt.
NEXT_PUBLIC_SITE_URL=
# Stripe payment link for the paid plan; unset = no upgrade block in the free letter.
PAYMENT_LINK_URL=
