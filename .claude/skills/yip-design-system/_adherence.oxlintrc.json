{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/**",
              "preview/**",
              "screens/**",
              "ui_kits/curator/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque|Hanken Grotesk|Space Mono))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque, Hanken Grotesk, Space Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='DealTicket'] > JSXAttribute > JSXIdentifier[name!=/^(?:place|country|origin|from|to|dates|legs|airline|price|usual|headline|eyebrow|gradient|hot|ctaLabel|onSee|key|ref|className|style|children)$/]",
        "message": "<DealTicket> doesn't accept that prop. Declared props: place, country, origin, from, to, dates, legs, airline, price, usual, headline, eyebrow, gradient, hot, ctaLabel, onSee."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
