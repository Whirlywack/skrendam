# Neon dev branch — READ access for published_deals/price_log/routes; the only WRITE is subscribers.
DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASS@DIRECT_HOST/neondb?sslmode=require

# Public site URL — used for metadataBase, robots.txt, and sitemap.
# Set this to your real domain in production (e.g. https://yip.flights).
# Falls back to http://localhost:3001 during local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Email (Resend). Leave RESEND_API_KEY unset to disable sending (single opt-in fallback).
RESEND_API_KEY=
YIP_FROM_EMAIL="Yip <hello@yip.lt>"
